  <div class="footer-bottom">
    <div class="container">
      <p>&copy; {year} Preston Berrett. Designed & built with intention.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-raised);
    margin-top: var(--sp-24);
  }

  /* Decorative rule */
  .footer-rule {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    padding-inline: clamp(var(--sp-5), 5vw, var(--sp-12));
    max-width: var(--max-w);
    margin-inline: auto;
  }
  .rule-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--geo), transparent);
  }
  .rule-diamond {
    width: 10px; height: 10px;
    border: 1px solid var(--gold);
    transform: rotate(45deg);
    flex-shrink: 0;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: start;
    gap: var(--sp-8) var(--sp-16);
    padding-top: var(--sp-10);
    padding-bottom: var(--sp-10);
  }

  .footer-brand { display: flex; flex-direction: column; gap: var(--sp-3); }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }
  .logo-diamond {
    width: 28px; height: 28px;
    background: var(--gold);
    transform: rotate(45deg);
    border-radius: 2px;
    flex-shrink: 0;
  }
  .footer-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text);
  }
  .footer-tagline {
    font-size: 0.82rem;
    color: var(--text-faint);
    line-height: 1.5;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }
  .footer-nav a {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    transition: color 200ms;
  }
  .footer-nav a:hover { color: var(--gold); }

  .footer-social {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }
  .footer-social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px; height: 36px;
    border: 1px solid var(--geo);
    border-radius: 3px;
    color: var(--text-muted);
    transition: all 200ms;
  }
  .footer-social a:hover {
    color: var(--gold);
    border-color: var(--gold-dim);
    background: var(--gold-glow);
  }

  .footer-bottom {
    border-top: 1px solid var(--geo);
    padding: var(--sp-5) 0;
  }
  .footer-bottom p {
    font-size: 0.72rem;
    color: var(--text-faint);
    letter-spacing: 0.06em;
  }

  @media (max-width: 640px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
    .footer-nav { flex-direction: row; flex-wrap: wrap; }
    .footer-social { flex-direction: row; }
  }
</style>
