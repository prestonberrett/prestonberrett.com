---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact"
  description="Get in touch with Preston Berrett, software engineer."
>
  <!-- ─── PAGE HERO ─── -->
  <section class="page-hero">
    <div class="hero-orb" aria-hidden="true"></div>
    <div class="container">
      <p class="eyebrow s1">Get in Touch</p>
      <h1 class="page-hero-title s2">
        Let's Start<br /><em>a Conversation</em>
      </h1>
      <p class="hero-desc s3">
        Email me directly or send a message below.
      </p>
    </div>
  </section>

  <!-- ─── CONTACT BODY ─── -->
  <section class="contact">
    <div class="container contact-inner">

      <!-- ─── FORM ─── -->
      <div class="form-col">
        <form class="contact-form" id="contact-form" action="https://formspree.io/f/mbgoknyg" method="POST" novalidate>
          <div class="form-row">
            <div class="form-field">
              <label for="name">Your Name</label>
              <input type="text" id="name" name="name" placeholder="Jane Smith" required autocomplete="name" aria-describedby="name-error" />
              <p class="field-error" id="name-error" hidden></p>
            </div>
            <div class="form-field">
              <label for="email">Email Address</label>
              <!-- pattern requires a dot in the domain; browsers otherwise accept "a@b", which Formspree rejects -->
              <input type="email" id="email" name="email" placeholder="hello@example.com" required autocomplete="email" pattern="[^@\s]+@[^@\s]+\.[^@\s]+" aria-describedby="email-error" />
              <p class="field-error" id="email-error" hidden></p>
            </div>
          </div>

          <div class="form-field">
            <label for="subject">Subject</label>
            <input type="text" id="subject" name="subject" placeholder="What's this about?" aria-describedby="subject-error" />
            <p class="field-error" id="subject-error" hidden></p>
          </div>

          <div class="form-field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="6" placeholder="Tell me about your project, role, or idea..." required aria-describedby="message-error"></textarea>
            <p class="field-error" id="message-error" hidden></p>
          </div>

          <button type="submit" class="btn btn-primary submit-btn">
            <span class="btn-text">Send Message</span>
            <svg class="btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="22" y1="2" x2="11" y2="13"/>
              <polygon points="22 2 15 22 11 13 2 9 22 2"/>
            </svg>
          </button>

          <p class="form-error" id="form-error" role="alert" hidden></p>
        </form>

        <!-- Success state: lives outside the form so it stays visible when the form is hidden -->
        <div class="form-success" id="form-success" tabindex="-1" aria-live="polite">
          <span class="success-diamond" aria-hidden="true"></span>
          <div>
            <p class="success-heading">Message sent!</p>
            <p class="success-sub">I'll get back to you within a day or two.</p>
          </div>
        </div>
      </div>

      <!-- ─── CONTACT INFO ─── -->
      <aside class="info-col">
        <!-- Spinning diamond decoration -->
        <div class="info-geo" aria-hidden="true">
          <div class="info-diamond"></div>
          <div class="info-ring"></div>
        </div>

        <div class="info-block">
          <h2>Direct Contact</h2>
          <ul class="contact-links">
            <li>
              <span class="contact-link-label">Email</span>
              <a href="mailto:prestonberrett@gmail.com" class="contact-link-val">
                prestonberrett@gmail.com
              </a>
            </li>
            <li>
              <span class="contact-link-label">GitHub</span>
              <a href="https://github.com/prestonberrett" target="_blank" rel="noopener noreferrer" class="contact-link-val">
                github.com/prestonberrett
              </a>
            </li>
            <li>
              <span class="contact-link-label">LinkedIn</span>
              <a href="https://www.linkedin.com/in/prestonberrett/" target="_blank" rel="noopener noreferrer" class="contact-link-val">
                linkedin.com/in/prestonberrett
              </a>
            </li>
          </ul>
        </div>

        <blockquote class="contact-quote">
          "The best projects start with a clear problem and an open conversation."
        </blockquote>
      </aside>
    </div>
  </section>
</Layout>

<script>
  const form       = document.getElementById('contact-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('form-success');
  const errorMsg   = document.getElementById('form-error');
  const submitBtn  = form?.querySelector('.submit-btn') as HTMLButtonElement | null;
  const btnText    = submitBtn?.querySelector('.btn-text');

  type Field = HTMLInputElement | HTMLTextAreaElement;

  const EMPTY_MESSAGES: Record<string, string> = {
    name: 'Please enter your name.',
    email: 'Please enter your email address.',
    message: 'Please enter a message.',
  };
  const BAD_EMAIL = 'Please enter a valid email address, like name@example.com.';

  function getField(name: string): Field | null {
    const el = form?.elements.namedItem(name);
    return el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement ? el : null;
  }

  function setFieldError(field: Field, message: string) {
    const errEl = document.getElementById(`${field.id}-error`);
    if (errEl) {
      errEl.textContent = message;
      errEl.hidden = !message;
    }
    if (message) field.setAttribute('aria-invalid', 'true');
    else field.removeAttribute('aria-invalid');
  }

  function clearAllErrors() {
    form?.querySelectorAll<Field>('input, textarea').forEach(f => setFieldError(f, ''));
    if (errorMsg) errorMsg.hidden = true;
  }

  function clientError(field: Field): string {
    const v = field.validity;
    if (v.valueMissing) return EMPTY_MESSAGES[field.name] ?? 'This field is required.';
    if (v.typeMismatch || v.patternMismatch) return field.name === 'email' ? BAD_EMAIL : 'Please check this field.';
    return '';
  }

  // Shows each error under its field and focuses the first one. Returns true if any were shown.
  function showErrors(errors: { field: Field; message: string }[]): boolean {
    errors.forEach(({ field, message }) => setFieldError(field, message));
    errors[0]?.field.focus();
    return errors.length > 0;
  }

  // Clear a field's error as soon as the user edits it
  form?.addEventListener('input', (e) => {
    const t = e.target;
    if ((t instanceof HTMLInputElement || t instanceof HTMLTextAreaElement) && t.hasAttribute('aria-invalid')) {
      setFieldError(t, '');
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearAllErrors();

    const invalid = Array.from(form.querySelectorAll<Field>('input, textarea'))
      .map(field => ({ field, message: clientError(field) }))
      .filter(x => x.message);
    if (showErrors(invalid)) return;

    if (submitBtn) submitBtn.disabled = true;
    if (btnText) btnText.textContent = 'Sending…';

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        const errors: { field?: string; code?: string; message?: string }[] = data?.errors ?? [];

        // Formspree tags field problems with the field name; show those next to the field
        const fieldErrors = errors.flatMap(err => {
          const field = err.field ? getField(err.field) : null;
          if (!field) return [];
          const label = form.querySelector(`label[for="${field.id}"]`)?.textContent ?? field.name;
          const message = err.code === 'TYPE_EMAIL' ? BAD_EMAIL : `${label}: ${err.message}`;
          return [{ field, message }];
        });
        const formErrors = errors.filter(err => !err.field || !getField(err.field));

        showErrors(fieldErrors);
        if (formErrors.length || !fieldErrors.length) {
          throw new Error(formErrors.map(x => x.message).filter(Boolean).join(' '));
        }
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.textContent = 'Send Message';
        return;
      }
      form.style.display = 'none';
      if (successMsg) {
        successMsg.style.display = 'flex';
        // Move focus off the now-hidden submit button so keyboard users land on the confirmation
        successMsg.focus();
      }
    } catch (err) {
      if (errorMsg) {
        errorMsg.textContent =
          (err instanceof Error && err.message) ||
          'Something went wrong. Please try again, or email me directly.';
        errorMsg.hidden = false;
      }
      if (submitBtn) submitBtn.disabled = false;
      if (btnText) btnText.textContent = 'Send Message';
    }
  });
</script>

<style>
  /* ─── PAGE HERO ─── */
  .hero-orb {
    position: absolute;
    bottom: -100px; left: -200px;
    width: 500px; height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(123, 58, 237, 0.12) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero-desc {
    font-size: clamp(1rem, 2vw, 1.1rem);
    color: var(--text-muted);
    line-height: 1.7;
    margin-top: var(--sp-5);
    max-width: 46ch;
  }

  /* ─── CONTACT BODY ─── */
  .contact { padding: var(--sp-12) 0 clamp(4rem, 8vw, 7rem); }
  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: var(--sp-12) var(--sp-16);
    align-items: start;
  }

  /* ─── FORM ─── */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-4);
  }
  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .form-field label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .form-field input,
  .form-field textarea {
    background: var(--bg-raised);
    border: 1px solid var(--geo);
    border-radius: 3px;
    color: var(--text);
    font-family: var(--font-body);
    font-size: 0.95rem;
    padding: var(--sp-3) var(--sp-4);
    outline: none;
    transition: border-color 200ms, box-shadow 200ms;
    resize: vertical;
  }
  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color: var(--text-faint);
  }
  .form-field input:focus,
  .form-field textarea:focus {
    border-color: var(--gold-dim);
    box-shadow: 0 0 0 3px var(--gold-glow);
  }
  .form-field input[aria-invalid="true"],
  .form-field textarea[aria-invalid="true"] {
    border-color: #ff9b9b;
  }
  .form-field input[aria-invalid="true"]:focus,
  .form-field textarea[aria-invalid="true"]:focus {
    box-shadow: 0 0 0 3px rgba(255, 155, 155, 0.2);
  }
  .field-error {
    font-size: 0.82rem;
    color: #ff9b9b;
  }

  .submit-btn {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
  }
  .submit-btn:disabled { opacity: 0.6; cursor: not-allowed; }

  /* Success state */
  .form-error {
    margin-top: 1rem;
    font-size: 0.88rem;
    color: #ff9b9b;
  }

  .form-success {
    display: none;
    align-items: center;
    gap: var(--sp-5);
    padding: var(--sp-6);
    background: var(--bg-raised);
    border: 1px solid var(--gold-dim);
    border-radius: 4px;
    background: var(--gold-glow);
  }
  .form-success:focus { outline: none; }
  .success-diamond {
    width: 24px; height: 24px;
    background: var(--gold);
    transform: rotate(45deg);
    flex-shrink: 0;
    border-radius: 2px;
  }
  .success-heading {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: var(--sp-1);
  }
  .success-sub { font-size: 0.88rem; color: var(--text-muted); }

  /* ─── INFO COL ─── */
  .info-col {
    display: flex;
    flex-direction: column;
    gap: var(--sp-8);
  }

  .info-geo {
    position: relative;
    height: 120px;
    margin-bottom: var(--sp-4);
  }
  .info-ring {
    position: absolute;
    top: 50%; left: 60px;
    width: 100px; height: 100px;
    border: 1px dashed var(--geo);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    animation: orbitRing 18s linear infinite;
  }
  .info-diamond {
    position: absolute;
    top: 50%; left: 60px;
    width: 40px; height: 40px;
    background: var(--gold-glow);
    border: 1px solid var(--gold);
    transform: translate(-50%, -50%) rotate(45deg);
    animation: spinDiamond 7s linear infinite;
  }

  .info-block h2 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: var(--sp-5);
  }

  .contact-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }
  .contact-links li {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--geo);
  }
  .contact-links li:last-child { border-bottom: none; }
  .contact-link-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .contact-link-val {
    font-size: 0.88rem;
    color: var(--gold);
    transition: opacity 200ms;
    word-break: break-all;
  }
  .contact-link-val:hover { opacity: 0.75; }

  .contact-quote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
    font-weight: 300;
    color: var(--text-muted);
    line-height: 1.6;
    padding-left: var(--sp-5);
    border-left: 2px solid var(--gold-dim);
  }

  @media (max-width: 900px) {
    .contact-inner { grid-template-columns: 1fr; }
    .info-col { order: -1; }
  }
  @media (max-width: 560px) {
    .form-row { grid-template-columns: 1fr; }
  }
</style>
